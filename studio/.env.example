# The editor is public: no authentication env vars are needed to run it.

# Optional server-only AI material rendering. Never expose this as a VITE_* variable.
# WARNING: /api/render has no authentication -- every visitor who can reach
# the deployment can trigger a render and spend the linked provider credits.
# The self-hosted server caps this with a per-client rate limit
# (RENDER_MAX_PER_HOUR, TRUST_PROXY -- see editor/README.md); it is a
# spending brake, not authentication.
OPENAI_API_KEY=your-openai-api-key
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# OPENAI_SUGGEST_MODEL=gpt-5-mini
# RENDER_MAX_PER_HOUR=10
# TRUST_PROXY=0
