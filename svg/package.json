{
  "name": "@namche/metaball-svg",
  "version": "0.1.0",
  "description": "React component that renders a NAMCHE metaball mark as inline SVG.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamcheAI/brand-studio.git",
    "directory": "svg"
  },
  "keywords": [
    "metaball",
    "svg",
    "react",
    "namche",
    "brandmark"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test",
    "lint": "oxlint"
  },
  "dependencies": {
    "@namche/metaball": "^2.0.0"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "oxlint": "^1.85.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
}
