{
  "name": "@namche/metaball-react",
  "version": "0.2.0",
  "description": "Embeddable React and Three.js renderer for NAMCHE metaball marks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NamcheAI/metaball.git",
    "directory": "renderer"
  },
  "homepage": "https://github.com/NamcheAI/metaball/tree/main/renderer#readme",
  "bugs": "https://github.com/NamcheAI/metaball/issues",
  "contributors": [
    { "name": "Michael Marte", "url": "https://github.com/fizzybubbele" },
    { "name": "Ruhm GmbH", "url": "https://ruhmetc.com/" },
    { "name": "BTLG Holding GmbH" }
  ],
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@namche/metaball": "^2.0.0"
  },
  "peerDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@types/react": "^19.2.17",
    "@types/three": "^0.186.0",
    "oxlint": "^1.83.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.186.0",
    "typescript": "~6.0.2"
  }
}
